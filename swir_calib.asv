function [T_LU, S_LU] = swir_calib(wl_gain, camera_gain, T_calibpoint, S_calibpoint)
arguments
    wl_gain (1,:) double
    camera_gain (1,:) double
    T_calibpoint (1,1) double
    S_calibpoint (1,1) double
end

T_LU = 500:100:3500;
S_unitless = zeros(1,length(T_LU));

for i=1:length(T_LU)
    B = blackbody(wl_gain,T_LU(i));
    S_unitless(i) = trapz(camera_gain .* B); % integration of black body signal multiplied by the camera spectral gain
end

S_calibpoint_unitless = S_unitless(T_LU == T_calibpoint);

S_LU = S_unitless .* S_calibpoint ./ S_calibpoint_unitless;
end

function B = blackbody(wl,T)
% blackbody Returns blackbody's spectral radiance at temperature T and wavelength
% wl following Planck's law.

% Inputs:
%   wl  [nm]    Wavelength
%   T   [K]     Temperature

% Output:
%   B   [W/m^2/nm/sr]   Spectral radiance
arguments
    wl (:,1) double
    T (1,1) double
end
h = 6.62607015e-34; % [Js]
c = 299792458; % [m/s]
kB = 1.380649e-23; % [J/K]
wl_m = wl*1e-9; % [nm] --> [m]
B = (2*h*c^2./(wl_m.^5)./(exp(h*c./(wl_m*kB*T))-1))/1e9; % spectral radiance [W/m^2/nm/sr]
end